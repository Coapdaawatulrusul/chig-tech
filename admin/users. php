<?php
include '../includes/config.php';
include '../includes/functions.php';
requireAdmin();
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['approve_id'])) {
    $id = (int)$_POST['approve_id'];
    $conn->query("UPDATE users SET is_approved=1 WHERE id=$id");
    header('Location: users.php'); exit;
}
$users = $conn->query("SELECT * FROM users ORDER BY created_at DESC");
include '../includes/header.php';
?>
<h2>User Management</h2>
<table>
    <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Approved</th><th>Action</th></tr>
    <?php while ($u = $users->fetch_assoc()): ?>
    <tr>
        <td><?= $u['id'] ?></td>
        <td><?= htmlspecialchars($u['name']) ?></td>
        <td><?= htmlspecialchars($u['email']) ?></td>
        <td><?= $u['role'] ?></td>
        <td><?= $u['is_approved'] ? 'Yes' : 'No' ?></td>
        <td>
            <?php if (!$u['is_approved']): ?>
            <form method="post" style="display:inline;">
                <input type="hidden" name="approve_id" value="<?= $u['id'] ?>">
                <button type="submit" class="btn">Approve</button>
            </form>
            <?php endif; ?>
        </td>
    </tr>
    <?php endwhile; ?>
</table>
<?php include '../includes/footer.php'; ?>